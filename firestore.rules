rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Room catalog & physical rooms: public reads so visitors can browse and check availability.
    match /roomTypes/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /rooms/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Bookings are read by any visitor because availability is computed on the client.
    // NOTE: contains guest PII — tighten this once you move availability to a backend
    // (Cloud Functions), e.g. require request.auth != null and role admin.
    match /bookings/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User profiles: readable by any signed-in user (needed for the admin customers page),
    // writable only by the account owner.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}